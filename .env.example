# AR Reconciliation Engine
APP_NAME=AR Reconciliation Engine
API_VERSION=1.0.0
# env can be "dev", "staging", "prod"
ENVIRONMENT=dev

# Database
DB_TYPE=sqlite
DATABASE_URL=sqlite:///./data/ar_reconciliation.db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=ar_reconciliation

# Simulation & Retry
FAILURE_RATE=0.20
MAX_RETRIES=3

# Matching
MATCH_TOLERANCE_PERCENT=5.0
HIGH_VALUE_THRESHOLD=10000.0


# Stale workflow detection
STALE_MINUTES=10

# AR reconciliation pipeline stages (comma-separated)
AR_RECONCILIATION_PIPELINE_STAGES=ingestion,matching,validation,decision_routing

# Timezone for timestamps (e.g. UTC, Asia/Kolkata, America/New_York)
TIMEZONE=UTC
